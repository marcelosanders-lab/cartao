#!/usr/bin/env bash
# Wrapper portátil para pdf_to_md.py.
#
# Resolve o diretório da skill a partir da própria localização deste script,
# então funciona igual em ~/.claude/skills/, em .claude/skills/ de um repo,
# ou em qualquer outro caminho. Nada de caminho hardcoded.
#
# Uso: pdf2md <entrada.pdf> [saida.md] [flags do pdf_to_md.py]
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *)  SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
  esac
done
SKILL_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

VENV="$SKILL_DIR/.venv"
PY="$VENV/bin/python"

bootstrap() {
  echo "[pdf2md] Preparando ambiente em $VENV (primeira execução)..." >&2
  if command -v uv >/dev/null 2>&1; then
    uv venv "$VENV" >&2
    uv pip install --python "$PY" --quiet pymupdf pymupdf4llm >&2
  else
    python3 -m venv "$VENV" >&2
    "$PY" -m pip install --quiet --upgrade pip >&2
    "$PY" -m pip install --quiet pymupdf pymupdf4llm >&2
  fi
}

if [ ! -x "$PY" ]; then
  bootstrap
elif ! "$PY" -c "import pymupdf, pymupdf4llm" >/dev/null 2>&1; then
  echo "[pdf2md] venv existe mas está incompleto; reinstalando dependências..." >&2
  bootstrap
fi

# --docling exige pacotes extras; instala sob demanda em vez de falhar.
for arg in "$@"; do
  if [ "$arg" = "--docling" ] || [ "$arg" = "--accurate" ]; then
    if ! "$PY" -c "import docling, docling_core" >/dev/null 2>&1; then
      echo "[pdf2md] Instalando docling (download grande, ~500MB de modelos na 1a execução)..." >&2
      if command -v uv >/dev/null 2>&1; then
        uv pip install --python "$PY" --quiet docling docling-core >&2
      else
        "$PY" -m pip install --quiet docling docling-core >&2
      fi
    fi
  fi
done

exec "$PY" "$SKILL_DIR/scripts/pdf_to_md.py" "$@"
